# ==============================================================================
# FRANKLINWH BATTERY AUTOMATION - CONFIGURATION FILE EXAMPLE
# ==============================================================================
# Copy this file to .env and customize for your setup
# 
# IMPORTANT: Never commit .env to git - it contains sensitive credentials
# Keep file permissions restricted: chmod 600 .env
# ==============================================================================

# ==============================================================================
# REQUIRED - Franklin WH Credentials
# ==============================================================================
# Your Franklin WH account credentials (same as mobile app login)
FRANKLIN_USERNAME=your_email@example.com
FRANKLIN_PASSWORD=your_password_here

# Gateway ID from Franklin WH mobile app
# Find at: App -> Settings -> System Info -> Gateway ID
# Format example: 10060005A02X24470437
FRANKLIN_GATEWAY_ID=your_gateway_id_here

# ==============================================================================
# REQUIRED - Battery Configuration
# ==============================================================================
# Your battery capacity in kWh (e.g., 13.6 for single aPower/aPower 2, 30 for aPower 30)
BATTERY_CAPACITY_KWH=13.6

# Charge rate as percentage per hour
# Test by timing how long to charge from 20% to 80% (60% / hours = rate)
# Typical values: ~10-15 for single aPower, ~30-35 for aPower 30
CHARGE_RATE_PER_HOUR=32.0

# ==============================================================================
# FEATURE TOGGLES - Enable/Disable Optional Features
# ==============================================================================
# Set to true/false to enable/disable features
# Disabled features are completely skipped in decision logic

# Solar panels connected to system?
SOLAR_ENABLED=true

# Time-of-Use rate schedule? (peak/off-peak pricing)
TOU_ENABLED=true

# Dynamic hourly pricing? (ComEd, etc.)
DYNAMIC_PRICING_ENABLED=false

# Weather-informed decisions?
WEATHER_ENABLED=false

# PVOutput solar tracking?
PVOUTPUT_ENABLED=false

# ==============================================================================
# V4 ADAPTIVE ENGINE
# ==============================================================================
# The v4 Adaptive Engine uses an 8-phase priority system (P1-P8) with
# forecast-aware charging, learned system profiles, and full rate schedule
# awareness. When disabled, falls back to v3.x time-based scheduling logic.
ADAPTIVE_ENGINE_ENABLED=true

# Number of battery units (1 for single aPower, 2 for dual, etc.)
# BATTERY_COUNT=1

# Reserve SOC percentage to maintain (passed to FranklinWH API)
# BACKUP_RESERVE_PCT=20

# Emergency preparedness mode — maintain higher reserve SOC for grid outages
# Useful during storm season, PSPS events, or known grid instability
# EMERGENCY_PREP_MODE=false

# ==============================================================================
# SOLAR FORECAST ENGINE
# ==============================================================================
# Weather-aware solar forecasting to prevent curtailment and optimize charging.
#
# HOW IT WORKS:
# Each morning, the engine predicts how much solar will reach the battery.
# It then limits grid charging to leave headroom for free solar energy.
# On sunny days: charge less from grid, let solar fill the battery.
# On cloudy days: charge more from grid to ensure target SOC by peak.
#
# FORECAST SOURCES (automatic, best-available):
#   1. Open-Meteo API (free, no key) — hourly tilted irradiance forecast
#   2. Weather calibration — local weather data improves accuracy over time
#   3. Learned profile — historical production averages (fallback)
#
# IMPORTANT: Only configure the array that charges your battery.
# If you have solar on a separate meter, don't include it here.
#
# Enable forecast-aware charging (requires ADAPTIVE_ENGINE_ENABLED=true)
# FORECAST_ENABLED=true
#
# Your location (used by Open-Meteo API)
# Find at: https://www.latlong.net/
# FORECAST_LATITUDE=38.91
# FORECAST_LONGITUDE=-120.84
#
# Battery-connected array physical parameters:
#   Tilt: roof pitch in degrees (0=flat, 90=vertical). Common: 20-30°
#   Azimuth: panel facing direction (meteorological convention):
#     0=South, -90=East, 90=West, 180/-180=North
#     To convert from compass bearing: subtract 180, negate
#     Examples: South-facing (180°) = 0, SW (225°) = 45, West (270°) = 90
#              SE (135°) = -45, East (90°) = -90, NW (315°) = -65 approx
#   kWp: total panel watts / 1000 (e.g., 16 x 435W = 6.96 kWp)
#
# FORECAST_HOUSE_TILT=22
# FORECAST_HOUSE_AZIMUTH=0
# FORECAST_HOUSE_KWP=6.96
#
# Solar forecast uses Open-Meteo (free, no API key required, 10k calls/day).
# No additional configuration needed beyond the array parameters above.

# NEM version for accurate export credit calculations
# Options: nem2, nem3 (affects how solar export value is calculated)
# NEM_VERSION=nem2

# Solar export configuration — does your system export surplus solar to the grid?
# false = non-export (surplus solar is curtailed/wasted when battery is full)
# true  = net-metered export (surplus solar earns grid credits)
# When false, the engine proactively drains battery to create headroom for solar
# absorption. When true, headroom management is skipped since surplus goes to grid.
# SOLAR_EXPORT=false

# CARE rate discount active? (California Alternate Rates for Energy)
# Affects rate calculations for optimization decisions
# CARE_RATE=false

# ==============================================================================
# SOLAR ARRAY CONFIGURATION
# ==============================================================================
# Comma-separated list of solar array names to monitor
# Each array needs a corresponding collector configured below
# Leave empty if not using local solar monitoring
# Examples:
#   SOLAR_ARRAYS=house           # Single Enphase array
#   SOLAR_ARRAYS=house,barn      # Two arrays (Enphase + SolarEdge)
SOLAR_ARRAYS=

# ----- Per-Array Configuration -----
# For each array listed in SOLAR_ARRAYS, define these variables using the
# pattern: SOLAR_ARRAY_{NAME}_{SETTING} (name in uppercase)
#
# Required for all arrays:
#   _NAME    = Display name
#   _TYPE    = Array type: enphase, solaredge
#   _MODEL   = Inverter/panel model (for logging)
#
# Required for Enphase arrays:
#   _IP       = Local IP of Enphase gateway
#   _SERIAL   = Gateway serial number
#   _EMAIL    = Enphase account email
#   _PASSWORD = Enphase account password
#
# Required for SolarEdge arrays:
#   _SITE_ID  = SolarEdge site ID
#   _API_KEY  = SolarEdge API key

# Example: Enphase house array
# SOLAR_ARRAY_HOUSE_NAME=House
# SOLAR_ARRAY_HOUSE_TYPE=enphase
# SOLAR_ARRAY_HOUSE_IP=192.168.1.100
# SOLAR_ARRAY_HOUSE_SERIAL=your_serial
# SOLAR_ARRAY_HOUSE_EMAIL=your_email@example.com
# SOLAR_ARRAY_HOUSE_PASSWORD=your_password
# SOLAR_ARRAY_HOUSE_MODEL=IQ8MC

# Example: SolarEdge barn array
# SOLAR_ARRAY_BARN_NAME=Barn
# SOLAR_ARRAY_BARN_TYPE=solaredge
# SOLAR_ARRAY_BARN_SITE_ID=your_site_id
# SOLAR_ARRAY_BARN_API_KEY=your_api_key
# SOLAR_ARRAY_BARN_MODEL=SolarEdge

# ==============================================================================
# MODBUS TCP INTEGRATION
# ==============================================================================
# Enable local Modbus TCP data collection from FranklinWH aGate
# Provides 100x faster readings (26ms vs 5000ms cloud API)
# When enabled, cloud API is used only for mode switching and verification
# When disabled, all data comes from the cloud API (original behavior)
MODBUS_ENABLED=false

# aGate IP address on your local network
# Find via your router's DHCP client list or network scanner
# The aGate exposes Modbus on port 502 by default
MODBUS_HOST=192.168.1.100

# Modbus TCP port (default 502 - rarely needs changing)
MODBUS_PORT=502

# Connection timeout in seconds
MODBUS_TIMEOUT=5.0

# Number of retry attempts on connection failure before falling back to cloud
MODBUS_RETRY_ATTEMPTS=3

# ==============================================================================
# TELEMETRY (optional)
# ==============================================================================
# Anonymous, opt-in usage telemetry to help improve the project.
# No personal info, API keys, IPs, or identifiable data is ever collected.
#
# HOW IT WORKS:
# On first dashboard load, a one-time popup asks if you'd like to opt in.
# Your choice is saved and the popup never appears again (even across rebuilds).
# No .env changes are required for the basic flow.
#
# OPTIONAL .env OVERRIDES:
# These override the dashboard popup if you prefer to control via config:
#
# Force telemetry on (skip popup, always send):
# TELEMETRY_ENABLED=true
#
# Force telemetry off (skip popup, never send):
# TELEMETRY_ENABLED=false
#
# Your state/region for aggregate geographic stats (optional)
# Only used if telemetry is enabled. Not auto-detected — you set this.
# Examples: CA, IL, TX, NY, ON, NSW
# TELEMETRY_REGION=CA
#
# Multi-meter system (separate meters for different solar arrays)
# MULTI_METER=false

# ==============================================================================
# SOLAREDGE PANEL-LEVEL MONITORING (optional)
# ==============================================================================
# Enables real per-optimizer/per-panel energy data collection from the
# SolarEdge monitoring portal. Provides health monitoring, degradation
# tracking, and anomaly detection at the individual panel level.
#
# This is separate from the SolarEdge cloud API used for the solar array
# dashboard (SOLAR_ARRAY_*_TYPE=solaredge). That API only provides
# inverter-level totals. This feature scrapes the portal for real
# per-optimizer data that matches what you see in the SolarEdge mobile app.
#
# Requires your SolarEdge monitoring portal login credentials
# (the email/password you use at monitoring.solaredge.com or mySolarEdge app)
# NOT the API key.
#
# Data collected every 15 minutes (portal refresh rate):
#   - Per-panel daily/weekly/monthly/lifetime energy (Wh)
#   - Inverter and string assignment per optimizer
#   - Real hardware serial numbers
#
# Data stored in SQLite tables: solaredge_readings, solaredge_inverter_readings
SOLAREDGE_PANEL_MONITORING=false
# SOLAREDGE_SITE_ID=your_site_id
# SOLAREDGE_USERNAME=your_portal_email@example.com
# SOLAREDGE_PASSWORD=your_portal_password

# ==============================================================================
# TOU SETTINGS (if TOU_ENABLED=true)
# ==============================================================================
# Peak period start hour (24-hour format)
# Examples: 17 = 5 PM, 14 = 2 PM, 16 = 4 PM
PEAK_START_HOUR=17

# Peak period end hour (24-hour format)
# Examples: 20 = 8 PM, 21 = 9 PM, 19 = 7 PM
PEAK_END_HOUR=20

# Which days have peak pricing?
# Options: all, weekdays, weekends
# Most utilities use weekdays only
PEAK_DAYS=weekdays

# Optional: Second peak period (uncomment if your utility has split peaks)
# PEAK2_START_HOUR=7
# PEAK2_END_HOUR=9
# PEAK2_DAYS=weekdays

# ==============================================================================
# SCHEDULING SETTINGS
# ==============================================================================
# How often the smart decision engine runs (minutes)
# Lower = more responsive, higher = less API usage
# Default depends on data source:
#   Cloud API only: 30 min (rate limit protection)
#   Modbus enabled: 10 min (local reads are fast)
#   Dynamic pricing + Modbus: 5 min
# Set to 0 to use the automatic default
CHECK_INTERVAL_MINUTES=0

# How many minutes before peak to run a guaranteed check
# Ensures mode is set correctly before peak starts
# Example: 5 means check runs at 16:55 for a 17:00 peak
PEAK_TRANSITION_BUFFER_MINUTES=5

# Your normal operating mode when not in peak protection
# Options: tou, self_consumption
# - tou: Time-of-Use mode (most common)
# - self_consumption: Self-Consumption mode
HOME_MODE=tou

# ==============================================================================
# DYNAMIC PRICING SETTINGS (if DYNAMIC_PRICING_ENABLED=true)
# ==============================================================================
# Pricing provider API
# Options: comed, (future: ercot, caiso)
PRICING_PROVIDER=comed

# Price threshold to trigger grid charging (cents per kWh)
# If current price is AT OR BELOW this, charge from grid
# Supports negative values for markets with negative pricing
# Examples:
#   4.0  = charge when grid is under 4 cents (typical for ComEd overnight)
#   0    = only charge when grid power is free or negative
#   -1.0 = only charge when you're getting paid more than 1 cent/kWh
PRICE_THRESHOLD_CENTS=4.0

# Price ceiling - never charge from grid if price above this (cents per kWh)
# Protects against charging during price spikes
# Supports negative values (though uncommon for a ceiling)
PRICE_CEILING_CENTS=10.0

# Solar override price (cents per kWh) - OPTIONAL
# When grid price drops to or below this threshold, charge from grid
# EVEN WHEN SOLAR IS PRODUCING. This overrides solar-first preference
# AND peak period protection.
#
# Use case: Utilities like ComEd can have negative pricing periods where
# they PAY you to consume electricity. In those periods, it's more
# profitable to charge from grid rather than use solar.
#
# Examples:
#   SOLAR_OVERRIDE_PRICE_CENTS=0      # Grab any free or negative pricing
#   SOLAR_OVERRIDE_PRICE_CENTS=-2     # Only grab credits below -2 cents
#   SOLAR_OVERRIDE_PRICE_CENTS=1      # Override solar when grid under 1 cent
#   (leave commented out to disable - solar-first always preferred)
#
# SOLAR_OVERRIDE_PRICE_CENTS=0

# ==============================================================================
# SOLAR SETTINGS (if SOLAR_ENABLED=true)
# ==============================================================================
# Total capacity in kW of the solar array(s) connected to your Franklin system
# Only include arrays that charge your battery — not separate-meter export arrays
# Example: 16 panels x 435W = 6.96 kW
SOLAR_CAPACITY_KW=6.96

# Minimum solar production to consider "good solar" (kW)
# Below this, system may switch to grid charging if needed
MIN_SOLAR_FOR_WAIT=0.5

# ==============================================================================
# WEATHER SETTINGS (if WEATHER_ENABLED=true)
# ==============================================================================
# Weather data provider
# Options: wunderground
WEATHER_PROVIDER=wunderground

# Weather Underground Personal Weather Station ID
# Find nearby stations at: https://www.wunderground.com/wundermap
WEATHER_STATION_ID=KXXXXXX

# Weather Underground API Key
# Get free key at: https://www.wunderground.com/member/api-keys
WEATHER_API_KEY=your_api_key_here

# Cloud cover threshold to trigger overnight charging (percent)
# If tomorrow's forecast shows cloud cover above this, charge overnight
CLOUDY_THRESHOLD_PERCENT=50

# ==============================================================================
# PVOUTPUT SETTINGS (if PVOUTPUT_ENABLED=true)
# ==============================================================================
# PVOutput API Key
# Get at: https://pvoutput.org/account.jsp
PVOUTPUT_API_KEY=your_api_key_here

# System IDs (comma-separated if multiple systems)
# Find at: https://pvoutput.org/listoutput.jsp
PVOUTPUT_SYSTEM_IDS=12345,67890

# ==============================================================================
# DECISION TUNING
# ==============================================================================
# Target State of Charge before peak period (%)
TARGET_SOC=95.0

# Safety margin when calculating charge time (hours)
# Higher = more conservative (starts charging earlier)
SAFETY_MARGIN_HOURS=0.5

# Charging strategy
# Options: conservative, balanced, aggressive
# - conservative: Charge early, don't risk running low
# - balanced: Default behavior, reasonable risk tolerance
# - aggressive: Maximize solar, accept more risk of not reaching target
CHARGING_STRATEGY=balanced

# Taper ceiling — maximum SOC the engine will grid-charge to before letting
# solar handle the rest. On non-export systems, battery charge rate tapers at
# high SOC, which means solar production that exceeds the reduced charge rate
# gets curtailed (wasted). By capping grid charging below the taper knee, the
# engine leaves room for solar to fill during peak production hours.
#
# Tuning: Start at 95 (effectively no cap) and check your curtailment data
# after each sunny day. Lower by 5 until curtailment drops to near zero.
# Typical sweet spot is 80-90 depending on your battery and solar size.
# Export systems can leave this at 95 since surplus goes to grid for credit.
# TAPER_CEILING_PCT=95

# ==============================================================================
# SYSTEM PATHS
# ==============================================================================
# These paths are INSIDE the Docker container, not your host filesystem.
# The docker-compose.yml bind mounts map your host directories to these
# container paths automatically. Most users should not change these defaults.
BASE_DIR=/app

# Log directory
LOG_DIR=/app/logs

# Data directory for savings tracking and SQLite database
DATA_DIR=/app/data

# Web directory for dashboard files served by nginx
WEB_DIR=/app/web

# ==============================================================================
# NOTIFICATIONS (optional)
# ==============================================================================
# Email notifications for daily reports
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# ==============================================================================
# TIMEZONE
# ==============================================================================
# Your local timezone (for Docker deployments)
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Los_Angeles

# ==============================================================================
# DOCKER DASHBOARD SETTINGS
# ==============================================================================
# Port for the built-in web dashboard (Docker only)
# Default: 8100 - change if this conflicts with another service
DASHBOARD_PORT=8100

# ==============================================================================
# ADVANCED / DEBUG
# ==============================================================================
# Enable verbose logging
DEBUG_MODE=false

# API retry settings
API_MAX_RETRIES=5
API_RETRY_DELAY=10
