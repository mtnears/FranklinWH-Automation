# ==============================================================================
# FRANKLINWH-AUTOMATION — minimal .env for a NEW install (v4.7.0 and later)
# ==============================================================================
# Copy to .env, fill in the values, keep it private (chmod 600 .env).
#
# Only secrets and deployment values live here. Everything else (site,
# battery, solar arrays, rate plan, engine behavior, integrations) is entered
# once in the guided setup: start the container, open the dashboard at
# http://<host>:8100 and follow the banner. Until the setup is committed the
# engine observes only and changes no battery modes.
#
# Existing installs upgrading from v4.6 keep their full .env; the review
# imports it. See .env.example for the complete legacy file.
# ==============================================================================

# ---- Required: FranklinWH account and gateway ---------------------------------
# Give the automation its own FranklinWH account or app user if you also run
# Home Assistant's FranklinWH integration: a new sign-in ends the previous one.
FRANKLIN_USERNAME=your_email@example.com
FRANKLIN_PASSWORD=your_password_here
# FranklinWH app: Settings > System Info > Gateway ID (also the aGate serial)
FRANKLIN_GATEWAY_ID=your_gateway_id_here

# ---- Required: time zone -----------------------------------------------------
TZ=America/Los_Angeles

# ---- Solar arrays (only if you have solar) -----------------------------------
# One block per array. <ID> is a short name you choose (house, barn, roof ...);
# the setup shows a card per ID where you enter its type, size and connection.
# Enphase (local Envoy): the Enlighten login the Envoy token is issued to.
#SOLAR_ARRAY_HOUSE_EMAIL=you@example.com
#SOLAR_ARRAY_HOUSE_PASSWORD=your_enlighten_password
# SolarEdge (monitoring API): the site API key from the monitoring portal.
#SOLAR_ARRAY_BARN_API_KEY=your_solaredge_api_key

# ---- Optional feature keys (needed only if you turn the feature on) ----------
# Weather Underground PWS data (weather.com key from your WU account)
#WEATHER_API_KEY=
# PVOutput uploads
#PVOUTPUT_API_KEY=
# SolarEdge portal login, for per-optimizer panel health
#SOLAREDGE_USERNAME=
#SOLAREDGE_PASSWORD=

# ---- Deployment (defaults are fine) ------------------------------------------
DASHBOARD_PORT=8100
#DEBUG_MODE=false
